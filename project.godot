; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Azad's Steam Frame Experiments"
run/main_scene="res://levels/hub.tscn"
config/features=PackedStringArray("4.7", "Mobile")
run/flush_stdout_on_print=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[frame_lab]

debug/panel_position_save=false
debug/show_controller_colliders=false
debug/text_composition_layer=true

[physics]

common/physics_ticks_per_second=90

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.06, 1)

[xr]

openxr/enabled=true
openxr/reference_space=1
openxr/foveation_with_subsampled_images=false
openxr/startup_alert=false
openxr/extensions/eye_gaze_interaction=true
openxr/extensions/render_model=true
shaders/enabled=true
